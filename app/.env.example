DATABASE_URL="postgresql://postgres.user:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.user:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
JWT_SECRET="your-jwt-secret-key"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Kho tệp giáo án / bài học / bài tập / bài nộp.
# Bỏ trống STORAGE_PROVIDER sẽ dùng cloudinary. Giá trị: cloudinary | minio.
STORAGE_PROVIDER="cloudinary"
# Mặc định và tối đa 10 MB/tệp; có thể đặt thấp hơn.
UPLOAD_MAX_MB="10"

# Chỉ cần khi dùng MinIO. Bucket phải được tạo sẵn và để private.
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET="educonnect"
MINIO_REGION="us-east-1"
# Khi MINIO_ENDPOINT là URL, giao thức và cổng lấy từ URL.
# Khi dùng tên máy chủ thuần, có thể khai báo hai biến sau:
# MINIO_PORT="9000"
# MINIO_USE_SSL="false"

# Địa chỉ công khai của ứng dụng (dùng cho ảnh xem trước khi chia sẻ link qua Zalo/Messenger).
# Trên Vercel có thể bỏ trống nếu đã có VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_APP_URL=""

# Nhập câu hỏi/đề kiểm tra từ tệp bằng AI (Google Gemini). Thiếu khóa thì phiên nhập báo lỗi rõ ràng, phần còn lại vẫn chạy bình thường.
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"
# AI_IMPORT_DAILY_LIMIT="20"
# Dùng Claude thay cho Gemini (không bắt buộc): AI_PROVIDER="anthropic" và ANTHROPIC_API_KEY="" (tùy chọn ANTHROPIC_MODEL).
# AI_PROVIDER="gemini"
# ANTHROPIC_API_KEY=""

# ── Vận hành / giám sát (xem docs/van-hanh.md) ─────────────────────────────
# Mức log JSON: debug | info | warn | error (mặc định info ở production)
# LOG_LEVEL="info"
# Truy vấn DB chậm hơn ngưỡng này (ms) sẽ được ghi log cảnh báo "slow_query"
# SLOW_QUERY_MS="500"
# Sentry: để trống thì tắt. DSN phía server và phía trình duyệt (NEXT_PUBLIC_ được đóng gói vào bản build).
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_TRACES_SAMPLE_RATE="0.05"
# Cron/worker hàng đợi: /api/jobs/run chỉ nhận "Authorization: Bearer <CRON_SECRET>" (>= 16 ký tự, Vercel tự gửi khi đặt biến này).
# CRON_SECRET=""
# /api/ready?… thêm chi tiết khi gửi header x-health-token bằng giá trị này
# HEALTH_TOKEN=""
# Đặt khi không chạy trên Vercel để log/Sentry ghi đúng phiên bản (vd: git sha)
# APP_RELEASE=""
# Đặt CSP_REPORT_ONLY=1 để thử Content-Security-Policy mới mà chưa chặn
# CSP_REPORT_ONLY=""

# ── SMS (eSMS.vn) — xem docs/sms.md ────────────────────────────────────────
# Có đủ 2 khoá này thì SMS được kích hoạt: gửi SMS thông báo cho phụ huynh (điểm, công bố điểm, vắng mặt) và
# BẮT phụ huynh xác minh số điện thoại bằng mã SMS + đặt mật khẩu mới ở lần đầu. Bỏ trống = tắt, hệ thống chạy như cũ.
# ESMS_API_KEY=""
# ESMS_SECRET_KEY=""
# Loại tin eSMS: 8 = đầu số cố định (mặc định); 2 = Brandname CSKH (cần ESMS_BRANDNAME đã được duyệt).
# ESMS_SMS_TYPE="8"
# ESMS_BRANDNAME=""
# 1 = eSMS nhận yêu cầu nhưng KHÔNG gửi thật (thử tích hợp, không tốn tiền)
# SMS_SANDBOX="0"
# Sự kiện nào gửi SMS (cách nhau dấu phẩy): score_changed, grades_published, absence. Bỏ trống = tất cả.
# SMS_EVENTS="grades_published,absence"
# Hạn mức chống chi phí phát sinh: tổng SMS/24 giờ toàn trường và SMS thông báo/số/24 giờ (mã xác minh không tính hạn mức số).
# SMS_DAILY_LIMIT="3000"
# SMS_PHONE_DAILY_LIMIT="5"
# Chỉ để chạy thử ở máy dev (ghi nội dung SMS ra log, không gửi). Không có tác dụng ở production.
# SMS_PROVIDER="log"
