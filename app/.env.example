DATABASE_URL="postgresql://postgres.user:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.user:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
JWT_SECRET="your-jwt-secret-key"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Kho tệp giáo án / bài học / bài tập / bài nộp.
# Bỏ trống STORAGE_PROVIDER sẽ dùng cloudinary. Giá trị: cloudinary | minio.
STORAGE_PROVIDER="cloudinary"
# Mặc định và tối đa 10 MB/tệp; có thể đặt thấp hơn.
UPLOAD_MAX_MB="10"

# Chỉ cần khi dùng MinIO. Bucket phải được tạo sẵn và để private.
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET="educonnect"
MINIO_REGION="us-east-1"
# Khi MINIO_ENDPOINT là URL, giao thức và cổng lấy từ URL.
# Khi dùng tên máy chủ thuần, có thể khai báo hai biến sau:
# MINIO_PORT="9000"
# MINIO_USE_SSL="false"

# Địa chỉ công khai của ứng dụng (dùng cho ảnh xem trước khi chia sẻ link qua Zalo/Messenger).
# Trên Vercel có thể bỏ trống nếu đã có VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_APP_URL=""

# Nhập câu hỏi/đề kiểm tra từ tệp bằng AI. Thiếu khóa thì phiên nhập báo lỗi rõ ràng, phần còn lại vẫn chạy bình thường.
ANTHROPIC_API_KEY=""
