{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "seed": "tsx prisma/seed.ts && tsx prisma/seed-gv.ts && tsx prisma/seed-lessons.ts && tsx prisma/seed-yearend.ts && tsx prisma/seed-parent.ts && tsx prisma/seed-bank.ts && tsx prisma/seed-secure-exam.ts && tsx prisma/seed-quiz-variants.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:db": "RUN_DATABASE_TESTS=1 node --import tsx --test tests/*.integration.test.ts",
    "openapi": "tsx scripts/openapi.ts",
    "ops:explain": "tsx scripts/ops/explain.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@prisma/client": "^7",
    "@sentry/nextjs": "^11.12.0",
    "bcryptjs": "^3",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "jsonwebtoken": "^9",
    "jszip": "^3.10.1",
    "katex": "^0.16.11",
    "lucide-react": "^1.70.0",
    "minio": "^8.0.7",
    "next": "16.4.5",
    "pino": "^10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xml2js": "^0.6.2",
    "zod": "^4"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2",
    "@types/jsonwebtoken": "^9",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/xml2js": "^0.4.14",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prisma": "^6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
