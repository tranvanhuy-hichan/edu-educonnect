    "/api/health": {
      "get": {
        "tags": [
          "Ops"
        ],
        "summary": "Liveness (không đụng DB)",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/ready": {
      "get": {
        "tags": [
          "Ops"
