                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "requestId": {
                      "description": "Mã truy vết, quản trị tra trong /van-hanh hoặc log",
                      "type": "string"
                    }
